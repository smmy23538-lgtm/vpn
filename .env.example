# ────────────────────────────────────────────────────────────────
#  VPN Platform — Environment Variables
#  Copy to .env and fill in all values before deploying.
# ────────────────────────────────────────────────────────────────

# ── Database ─────────────────────────────────────────────────────
POSTGRES_PASSWORD=changeme_use_a_strong_password_here

# ── Secrets ──────────────────────────────────────────────────────
# JWT signing key — generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=

# AES-256 encryption key for WireGuard private keys stored in DB — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=

# ── wg-easy ──────────────────────────────────────────────────────
# URL of your wg-easy API (the management port, NOT the WireGuard UDP port)
WGEASY_URL=http://3.21.126.65:51821

# The password you set in PASSWORD_HASH when running wg-easy
# This is the plaintext password (not the bcrypt hash)
WGEASY_PASSWORD=your_wgeasy_plaintext_password

# ── VPN Server Display Info ───────────────────────────────────────
VPN_SERVER_HOST=3.21.126.65
VPN_SERVER_PORT=51830
VPN_SERVER_NAME=US East
VPN_SERVER_COUNTRY=United States

# ── CORS ─────────────────────────────────────────────────────────
# Your production domain(s), comma-separated
CORS_ORIGIN=https://yourdomain.com

# ── Scheduler ────────────────────────────────────────────────────
EXPIRY_CHECK_CRON=0 0 * * *
EXPIRY_WARNING_DAYS=7

# ── Frontend ─────────────────────────────────────────────────────
# WebSocket URL — leave blank to auto-detect from browser window.location
VITE_WS_URL=
